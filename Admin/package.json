{
  "name": "pothole-detection-admin",
  "version": "1.0.0",
  "description": "Admin Module - Pothole Detection System",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && venv\\Scripts\\python.exe main.py",
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
